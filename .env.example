# ─── TheEights Daemon Configuration ───────────────────────────────────
# Copy to .env and uncomment/modify values as needed.
# See README.md "Provider Configuration" for details.

# Core
EIGHTS_HOME=~/.eights
EIGHTS_LOG_LEVEL=info

# ─── Provider Selection ───────────────────────────────────────────────
# Choose: ollama | openai | deepseek | authhub
# EIGHTS_PROVIDER sets both embed + LLM. Override individually below.
EIGHTS_PROVIDER=ollama
# EIGHTS_EMBED_PROVIDER=ollama
# EIGHTS_LLM_PROVIDER=ollama

# Cloud providers require explicit opt-in (set to 1).
# Without this, only ollama (localhost) is allowed.
# EIGHTS_ALLOW_CLOUD_PROVIDERS=0

# Master toggle for LLM completions (ALL providers). Must be "1" to enable.
# Controls: LLM-as-Judge eval, Cell Classifier fallback, Miner proposal drafting.
EIGHTS_LLM_COMPLETIONS=0

# ─── Latency budgets (keep MCP calls under the gateway's ~120s) ──────
# Inline = completions awaited DURING an MCP request (cells.classify,
# evolution.evaluate): tight timeout, no retries, so a degraded provider fails
# fast instead of stacking 30s×4 ≈ 127s into a gateway timeout.
# EIGHTS_INLINE_LLM_TIMEOUT_MS=20000
# EIGHTS_INLINE_LLM_RETRIES=0
# Background = miner (off the request path): tolerant.
# EIGHTS_BG_LLM_TIMEOUT_MS=30000
# EIGHTS_BG_LLM_RETRIES=2
# AbortSignal timeout for the local Ollama embedder + completer (bare fetch).
# EIGHTS_OLLAMA_TIMEOUT_MS=20000
# Per-tool wall-clock deadline in the MCP seam. Fires before the gateway's
# ~120s so an opaque gateway timeout becomes a fast "tool_deadline_exceeded".
# EIGHTS_TOOL_DEADLINE_MS=90000
# Completed calls slower than this log at warn (slow-call telemetry).
# EIGHTS_TOOL_SLOW_WARN_MS=2000
# Periodic process memory/CPU gauge interval (ms); 0 disables.
# EIGHTS_MEM_GAUGE_MS=60000

# ─── Ollama (local, default) ─────────────────────────────────────────
EIGHTS_OLLAMA_URL=http://localhost:11434
EIGHTS_EMBEDDING_MODEL=nomic-embed-text
EIGHTS_EMBEDDING_DIM=768
EIGHTS_LLM_MODEL=gpt-oss:20b
EIGHTS_LLM_FALLBACK=qwen3:4b

# ─── OpenAI ──────────────────────────────────────────────────────────
# Requires: EIGHTS_ALLOW_CLOUD_PROVIDERS=1
# Supports both embeddings and completions.
# EIGHTS_OPENAI_API_KEY=sk-...
# EIGHTS_OPENAI_BASE_URL=https://api.openai.com
# EIGHTS_OPENAI_EMBED_MODEL=text-embedding-3-small
# EIGHTS_OPENAI_EMBED_DIM=1536
# EIGHTS_OPENAI_LLM_MODEL=gpt-4o-mini

# ─── DeepSeek (completions only — no embeddings API) ─────────────────
# Requires: EIGHTS_ALLOW_CLOUD_PROVIDERS=1
# Only valid for EIGHTS_LLM_PROVIDER. Setting EIGHTS_EMBED_PROVIDER=deepseek
# falls back to NullEmbedder (no-op).
# EIGHTS_DEEPSEEK_API_KEY=sk-...
# EIGHTS_DEEPSEEK_BASE_URL=https://api.deepseek.com
# EIGHTS_DEEPSEEK_LLM_MODEL=deepseek-v4-flash

# ─── AuthHub SDK (local-only, gitignored) ────────────────────────────
# Requires: EIGHTS_ALLOW_CLOUD_PROVIDERS=1 + @authhub/sdk installed locally
# + daemon/src/providers/local/ files present (see README).
# Routes through AuthHub's multi-provider proxy for flexible model selection.
# EIGHTS_AUTHHUB_BASE_URL=https://your-authhub-instance.com
# EIGHTS_AUTHHUB_API_KEY=ak_...
# EIGHTS_AUTHHUB_EMBED_MODEL=text-embedding-3-small
# EIGHTS_AUTHHUB_EMBED_DIM=1536
# EIGHTS_AUTHHUB_LLM_MODEL=gpt-4o-mini
# EIGHTS_AUTHHUB_ROUTE_ALIAS=

# ─── Graph Store ─────────────────────────────────────────────────────
# Options: ladybug | kuzu | stub
EIGHTS_GRAPH_DRIVER=ladybug

# ─── Observability (localhost-only, per AGENTS.md rule 5) ────────────
# EIGHTS_OTEL_ENABLED=0
# EIGHTS_OTEL_ENDPOINT=http://localhost:4318/v1/traces

# ─── Consumer System Roots ───────────────────────────────────────────
# EIGHTS_RLM_ROOT=C:/AiAppDeployments

# ─── Development / Debug ─────────────────────────────────────────────
# EIGHTS_DISABLE_WATCHERS=0
# EIGHTS_SKIP_AUDIT_CHECK=0
