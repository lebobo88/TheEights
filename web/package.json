{
  "name": "@eights/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Living Agent-BOM Atlas — read-only web observability UI for TheEights. New consumer-style package; talks to the eights-daemon ONLY over the existing MCP stdio boundary.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "bridge": "node --import tsx server/index.ts",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  }
}
